{
  "name": "mlc-isometric-heatmap",
  "version": "1.4.0",
  "description": "A reusable TypeScript library to render high-quality isometric 3D heatmaps in SVG.",
  "main": "dist/index.umd.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.es.js",
      "require": "./dist/presets.umd.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && vite build --config vite.presets.config.mts && tsc",
    "build:demo": "vite build --config vite.demo.config.mts",
    "book:images": "node book/generate-images.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "prepublishOnly": "node scripts/check-release.mjs && npm run build"
  },
  "keywords": [
    "heatmap",
    "isometric",
    "svg",
    "typescript",
    "3d",
    "github-contributions",
    "calendar"
  ],
  "author": "Michael Lechner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlechner911/mlcheatmap.git"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
